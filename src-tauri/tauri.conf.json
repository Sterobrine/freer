{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Freer",
  "version": "0.4.0",
  "identifier": "com.freer.app",
  "build": {
    "beforeDevCommand": "pnpm --dir gui dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --dir gui build",
    "frontendDist": "../gui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Freer",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ]
  }
}
